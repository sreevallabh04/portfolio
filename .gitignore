# Dependencies
node_modules/

# Build artifacts
dist/
build/
.vite/
*.tsbuildinfo

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables — never commit these.
# Every VITE_* value is inlined into the client bundle at build time, so
# anything in here is public once deployed. Keep .env.example as the template.
.env
.env.*
!.env.example

# Personal documents kept alongside the project but not part of it.
# The 75 Hard plan contains health data (blood work, body composition); it is
# the source for the fitness page's content, not something to publish.
75_Hard_Plan*.docx
*.private.md

