# Copy to .env and fill in. Every VITE_* value is inlined into the JavaScript
# bundle at build time and is therefore PUBLIC — never put a secret here that
# you would not print on the homepage.

# --- Supabase (chatbot sessions, memories gallery, admin console) ---
# Optional. When unset, chat/memories/admin degrade to an offline state instead
# of crashing the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Groq (AI chatbot replies) ---
# WARNING: this key ships to every visitor's browser and can be read from the
# bundle or the network tab. Anyone can spend your quota with it.
# Proxy Groq through a serverless function and drop this variable when you can.
VITE_GROQ_API_KEY=

# --- EmailJS (new-chat notifications) ---
# Public by design; lock the template down to your own domain in the EmailJS
# dashboard.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Admin console ---
# WARNING: this is compared in the browser and is visible in the bundle, so it
# only hides the console from casual visitors. Real protection has to come from
# Supabase auth plus row-level security on chat_sessions/messages.
VITE_ADMIN_PASSWORD=
