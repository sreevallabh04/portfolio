# --- Public site origin ---
# The canonical host, used for canonical links, og:image, JSON-LD and the
# sitemap. Leave unset and the build falls back to the host it is deployed
# to (Netlify URL / Vercel production URL), then to the default domain.
# Set it explicitly in production so one host is canonical.
VITE_SITE_URL=

# Copy to .env and fill in. Every VITE_* value is inlined into the JavaScript
# bundle at build time and is therefore PUBLIC — never put a secret here that
# you would not print on the homepage.

# --- Supabase (chatbot sessions, memories gallery, admin console) ---
# Optional. When unset, chat/memories/admin degrade to an offline state instead
# of crashing the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Groq (AI chatbot replies) ---
# WARNING: this key ships to every visitor's browser and can be read from the
# bundle or the network tab. Anyone can spend your quota with it.
# Proxy Groq through a serverless function and drop this variable when you can.
VITE_GROQ_API_KEY=

# --- EmailJS (new-chat notifications) ---
# Public by design; lock the template down to your own domain in the EmailJS
# dashboard.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Blog publishing (local only, NOT prefixed VITE_) ---
# Used by scripts/publish-posts.mjs. Put these in .env.local, never .env —
# without the VITE_ prefix they stay out of the client bundle, and .env.local
# is gitignored. This signs in as an ordinary user, so every write still goes
# through row-level security. Never use a service_role key here.
BLOG_ADMIN_EMAIL=
BLOG_ADMIN_PASSWORD=
